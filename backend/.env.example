# Copy to .env and fill in. Every value here has a default except JWT_SECRET.

# Where the server listens. Use 0.0.0.0 behind a reverse proxy or in a container.
HOST=127.0.0.1
PORT=8787

# SQLite database file (relative to backend/). Created by `npm run db:deploy`.
DATABASE_URL=file:./data/archangel.db

# Signs session tokens. At least 32 random characters; keep it secret.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# How long a sign-in lasts before the client signs in again.
JWT_TTL_HOURS=24

# Mojang's session server, used to confirm sign-ins (hasJoined).
MOJANG_SESSION_URL=https://sessionserver.mojang.com

# DEVELOPMENT ONLY. Lets offline/dev accounts in without Mojang: enables POST /auth/dev and
# WebSocket hellos without a token. Never turn this on for a public server.
ALLOW_UNVERIFIED=false

# Set to true behind a reverse proxy (nginx, Caddy, Cloudflare) so rate limits see real client IPs.
TRUST_PROXY=false

# Requests per minute per IP, for all routes and for sign-in.
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

# fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info
